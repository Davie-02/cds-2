# Copy to .env for local development. In production set these on the host (e.g. Render).

# Postgres connection string.
DATABASE_URL=postgres://localhost:5432/driving_school
# Set to true when the database requires SSL (most hosted Postgres services do).
DATABASE_SSL=false

# Long random string used to sign login cookies, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# How long a login lasts, in days.
SESSION_DAYS=14

# The site's public address, used for links in search results and the sitemap.
PUBLIC_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
# Set to true when running behind a proxy or load balancer (Render, Railway, Nginx).
TRUST_PROXY=false
NODE_ENV=development

# First owner account. Used only when no owner exists yet; change the password after signing in.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password
OWNER_NAME=Owner

# Largest file staff or students may upload, in megabytes.
MAX_UPLOAD_MB=25

# Optional: send the daily reminder email (vehicle papers, services, learner's permits).
# The recipient is set in the admin under Settings → Reminders.
SMTP_URL=
MAIL_FROM=
